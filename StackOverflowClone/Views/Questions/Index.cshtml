@* @model IEnumerable<StackOverflowClone.Models.Question> *@
@* *@
@* *@
@* <div class="container mt-4"> *@
@*     <div class="d-flex justify-content-between align-items-center"> *@
@*         <h2>Questions</h2> *@
@*         <a asp-action="Create" class="btn btn-primary"> Ask Question</a> *@
@*     </div> *@
@*     <div class="mt-4"> *@
@*         @foreach (var question in Model) *@
@*         { *@
@*             <div class="card mb-3"> *@
@*                 <div class="card-body"> *@
@*                     <h5 class="card-title"> *@
@*                         <a asp-action="Details" asp-route-id="@question.Id"> *@
@*                             @question.Title *@
@*                         </a> *@
@*                     </h5> *@
@*                     <p class="card-text">@(question.Content?.Substring(0, Math.Min(200, question.Content.Length)))...</p> *@
@*                     <div class="d-flex justify-content-between"> *@
@*                         <small class="text-muted"> *@
@*                             Asked @question.CreatedDate.ToString("MMM dd, yyyy") *@
@*                         </small> *@
@*                         <div> *@
@*                             <span class="badge bg-primary">@question.VoteCount votes</span> *@
@*                         </div> *@
@*                     </div> *@
@*                 </div> *@
@*             </div> *@
@*         } *@
@*     </div> *@
@* </div> *@
