@model StackOverflowClone.Features.Questions.Queries.QuestionDetailDto

<div class="container mt-4">
    <div class="card">
        <div class="card-body">
            <h2 class="card-title">@Model.Title</h2>
            <div class=" d-flex align-items-center mb-3">
                <div class="text-muted">
                    Asked by @Model.UserName on @Model.CreatedDate.ToString("MMM dd , yyyy")
                </div>

                <div class="ms-2">
                    <span class="badge bg-primary">@Model.VoteCount votes </span>
                </div>
            </div>

            <p class="card-text">@Model.Content</p>

        </div>
    </div>
    
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-primary">Back to List</a>
    </div>
</div>
